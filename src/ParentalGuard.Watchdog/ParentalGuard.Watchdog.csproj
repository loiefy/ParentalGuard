    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ParentalGuard.Watchdog</RootNamespace>
    <AssemblyName>ParentalGuard.Watchdog</AssemblyName>
    <UserSecretsId>dotnet-ParentalGuard.Watchdog-2f6a2b7a-3f7a-4d9e-9c9b-6a6b9f2e9c6a</UserSecretsId>
