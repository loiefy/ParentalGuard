<Page
    x:Class="ParentalGuard.UI.Views.OnboardingRecoveryKeyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MinWidth="320" MaxWidth="480">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" />

            <TextBlock Text="{x:Bind ViewModel.RecoveryKeyDisplay, Mode=OneWay}"
                       FontFamily="Consolas"
                       FontSize="18"
                       TextWrapping="Wrap"
                       IsTextSelectionEnabled="True" />

            <Button x:Name="CopyButton" HorizontalAlignment="Left" Click="OnCopyClick" />

            <CheckBox x:Name="ConfirmCheckBox" IsChecked="{x:Bind ViewModel.RecoveryKeySavedConfirmed, Mode=TwoWay}" />

            <TextBlock Text="{x:Bind ViewModel.RecoveryErrorMessage, Mode=OneWay}"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.HasRecoveryError, Mode=OneWay}" />

            <Button x:Name="ContinueButton"
                    HorizontalAlignment="Right"
                    IsEnabled="{x:Bind ViewModel.RecoveryKeySavedConfirmed, Mode=OneWay}"
                    Click="OnContinueClick" />
        </StackPanel>
    </Grid>
</Page>
