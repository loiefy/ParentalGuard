<Page
    x:Class="ParentalGuard.UI.Views.OnboardingSetPasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MinWidth="320" MaxWidth="420">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />

            <TextBlock x:Name="PasswordLabel" />
            <PasswordBox x:Name="PasswordInput" MaxLength="50" PasswordChanged="OnPasswordChanged" />
            <TextBlock x:Name="StrengthText" />

            <TextBlock x:Name="ConfirmPasswordLabel" />
            <PasswordBox x:Name="ConfirmPasswordInput" MaxLength="50" />

            <TextBlock Text="{x:Bind ViewModel.PasswordErrorMessage, Mode=OneWay}"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.HasPasswordError, Mode=OneWay}" />

            <Button x:Name="ContinueButton"
                    HorizontalAlignment="Right"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                    Click="OnContinueClick" />
        </StackPanel>
    </Grid>
</Page>
