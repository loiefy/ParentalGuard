<Page
    x:Class="ParentalGuard.UI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20" MaxWidth="640" HorizontalAlignment="Stretch">

            <InfoBar Severity="Error" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasLoadError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.LoadErrorMessage, Mode=OneWay}" />

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          HorizontalAlignment="Center" />

            <StackPanel Spacing="24" Visibility="{x:Bind ViewModel.IsNotLoading, Mode=OneWay}">

                <!-- Mục 6.4 — Thông điệp overlay (FE-012/FE-012a). -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="OverlayMessageLabel" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox x:Name="OverlayMessageInput" MaxLength="255" TextWrapping="Wrap" AcceptsReturn="False"
                             Text="{x:Bind ViewModel.OverlayMessage, Mode=TwoWay}"
                             BeforeTextChanging="OnOverlayMessageBeforeTextChanging" />
                    <TextBlock Text="{x:Bind ViewModel.OverlayMessageRemainingChars, Mode=OneWay}" Opacity="0.7" />
                    <InfoBar Severity="Error" IsClosable="False"
                             IsOpen="{x:Bind ViewModel.HasOverlayMessageError, Mode=OneWay}"
                             Message="{x:Bind ViewModel.OverlayMessageError, Mode=OneWay}" />
                    <InfoBar Severity="Success" IsClosable="False"
                             IsOpen="{x:Bind ViewModel.HasOverlayMessageStatus, Mode=OneWay}"
                             Message="{x:Bind ViewModel.OverlayMessageStatus, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveOverlayMessageButton" Click="OnSaveOverlayMessageClick" />
                        <Button x:Name="ResetOverlayMessageButton" Click="OnResetOverlayMessageClick" />
                    </StackPanel>
                </StackPanel>

                <!-- Mục 6.4 — Quản lý whitelist (MISC-030). -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="WhitelistHeaderText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <InfoBar Severity="Error" IsClosable="False"
                             IsOpen="{x:Bind ViewModel.HasWhitelistError, Mode=OneWay}"
                             Message="{x:Bind ViewModel.WhitelistError, Mode=OneWay}" />
                    <InfoBar Severity="Success" IsClosable="False"
                             IsOpen="{x:Bind ViewModel.HasWhitelistStatus, Mode=OneWay}"
                             Message="{x:Bind ViewModel.WhitelistStatus, Mode=OneWay}" />
                    <ListView ItemsSource="{x:Bind ViewModel.WhitelistedProcessNames, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center" />
                                    <Button Tag="{x:Bind}" Click="OnRemoveWhitelistEntryClick" Loaded="OnRemoveWhitelistButtonLoaded" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Mục 6.4/ADR-125 — Chế độ hiệu năng (PERF-050b), 2 lựa chọn, có hiệu lực ngay. -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PerformanceModeHeaderText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <RadioButtons x:Name="PerformanceModeRadios" SelectionChanged="OnPerformanceModeSelectionChanged">
                        <RadioButton x:Name="BalancedRadio" />
                        <RadioButton x:Name="MaximumProtectionRadio" />
                    </RadioButtons>
                    <InfoBar Severity="Error" IsClosable="False"
                             IsOpen="{x:Bind ViewModel.HasPerformanceModeError, Mode=OneWay}"
                             Message="{x:Bind ViewModel.PerformanceModeError, Mode=OneWay}" />
                </StackPanel>

                <!-- Mục 6.4 — Đổi mật khẩu (PWD-040/041), tự gate qua old_password (không qua S5). -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ChangePasswordHeaderText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="OldPasswordLabel" />
                    <PasswordBox x:Name="OldPasswordInput" MaxLength="50" />
                    <TextBlock x:Name="NewPasswordLabel" />
                    <PasswordBox x:Name="NewPasswordInput" MaxLength="50" />
                    <TextBlock x:Name="ConfirmNewPasswordLabel" />
                    <PasswordBox x:Name="ConfirmNewPasswordInput" MaxLength="50" />
                    <CheckBox x:Name="RegenerateRecoveryKeyCheckBox" IsChecked="{x:Bind ViewModel.RegenerateRecoveryKey, Mode=TwoWay}" />
                    <InfoBar Severity="Error" IsClosable="False"
                             IsOpen="{x:Bind ViewModel.HasChangePasswordError, Mode=OneWay}"
                             Message="{x:Bind ViewModel.ChangePasswordError, Mode=OneWay}" />
                    <InfoBar Severity="Success" IsClosable="False"
                             IsOpen="{x:Bind ViewModel.HasChangePasswordStatus, Mode=OneWay}"
                             Message="{x:Bind ViewModel.ChangePasswordStatus, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ChangePasswordButton" Click="OnChangePasswordClick"
                                IsEnabled="{x:Bind ViewModel.CanSubmitChangePassword, Mode=OneWay}" />
                        <HyperlinkButton x:Name="ForgotOldPasswordLink" Click="OnForgotOldPasswordClick" />
                    </StackPanel>

                    <!-- Architecture/10 mục 6.4 — hiển thị Recovery Key mới đúng 1 lần, cùng mẫu hình S1 bước 3. -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasNewRecoveryKeyDisplay, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.NewRecoveryKeyDisplay, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="18" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="NewRecoveryKeyCopyButton" Click="OnCopyNewRecoveryKeyClick" />
                            <Button x:Name="NewRecoveryKeyAcknowledgeButton" Click="OnAcknowledgeNewRecoveryKeyClick" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
