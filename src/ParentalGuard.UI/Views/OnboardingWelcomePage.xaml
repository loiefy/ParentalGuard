<Page
    x:Class="ParentalGuard.UI.Views.OnboardingWelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="480">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" />
            <CheckBox x:Name="AcknowledgeCheckBox" IsChecked="{x:Bind ViewModel.IntroAcknowledged, Mode=TwoWay}" />
            <Button x:Name="ContinueButton"
                    HorizontalAlignment="Right"
                    IsEnabled="{x:Bind ViewModel.IntroAcknowledged, Mode=OneWay}"
                    Command="{x:Bind ViewModel.AcknowledgeIntroCommand}" />
        </StackPanel>
    </Grid>
</Page>
