<Page
    x:Class="ParentalGuard.UI.Views.OnboardingWelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="560" Padding="24">
            <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="26" TextWrapping="Wrap" Margin="0,0,0,8" />

            <!-- FE-032/FE-032a: các giá trị cốt lõi — không nền riêng, cỡ chữ nhỏ hơn, có hiệu ứng rê chuột; dựng ở code-behind. -->
            <StackPanel x:Name="ValueCards" Spacing="4" />

            <!-- FE-031/FE-031a: đoạn giải thích vẫn hiển thị, không còn ô tick xác nhận. -->
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" Opacity="0.75" FontSize="13" Margin="0,8,0,0" />
            <Button x:Name="ContinueButton"
                    HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="180" MinHeight="44" FontSize="16" Padding="24,8"
                    Margin="0,8,0,0"
                    Command="{x:Bind ViewModel.AcknowledgeIntroCommand}" />
        </StackPanel>
    </ScrollViewer>
</Page>
