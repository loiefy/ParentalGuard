<Page
    x:Class="ParentalGuard.UI.Views.OnboardingWelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="640" Padding="24">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />

            <!-- FE-032 (2026-10-05): các giá trị cốt lõi của ứng dụng dạng thẻ, có hiệu ứng rê chuột — dựng ở code-behind. -->
            <StackPanel x:Name="ValueCards" Spacing="10" />

            <!-- FE-031: đoạn giải thích bắt buộc đọc + xác nhận. -->
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" Opacity="0.85" Margin="0,8,0,0" />
            <CheckBox x:Name="AcknowledgeCheckBox" IsChecked="{x:Bind ViewModel.IntroAcknowledged, Mode=TwoWay}" />
            <Button x:Name="ContinueButton"
                    HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.IntroAcknowledged, Mode=OneWay}"
                    Command="{x:Bind ViewModel.AcknowledgeIntroCommand}" />
        </StackPanel>
    </ScrollViewer>
</Page>
