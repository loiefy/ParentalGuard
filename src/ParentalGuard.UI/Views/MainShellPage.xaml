<Page
    x:Class="ParentalGuard.UI.Views.MainShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- FE-005 (Spec 03 v0.13.0, 2026-10-01): nền trang trí — bông sen ~80% vùng nội dung (tối hơn nền 1 chút,
         nền sáng hơn mặc định 1 chút); thanh menu trái sáng hơn 1 chút với các hình tròn mờ phía sau. -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PgContentBackgroundBrush" Color="#26262B" />
                    <SolidColorBrush x:Key="PgLotusBrush" Color="#1F1F24" />
                    <SolidColorBrush x:Key="PgPaneBackgroundBrush" Color="#303037" />
                    <Color x:Key="PgPaneCircleColor">#3C3C45</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PgContentBackgroundBrush" Color="#FAFAFC" />
                    <SolidColorBrush x:Key="PgLotusBrush" Color="#EFEFF3" />
                    <SolidColorBrush x:Key="PgPaneBackgroundBrush" Color="#F1F1F5" />
                    <Color x:Key="PgPaneCircleColor">#E2E2E9</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <!-- Lớp nền vùng nội dung: lệch trái đúng bằng bề rộng thanh menu (cập nhật ở code-behind). -->
        <Grid x:Name="ContentBackdrop" Background="{ThemeResource PgContentBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="8*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Viewbox Grid.Row="1" Grid.Column="1" Stretch="Uniform" IsHitTestVisible="False">
                <!-- Bông sen vector (toạ độ 0..200 × 0..150): 5 cánh xoay quanh gốc + đài sen. -->
                <Canvas Width="200" Height="150">
                    <Path Fill="{ThemeResource PgLotusBrush}" Data="M100,128 C78,110 70,72 100,30 C130,72 122,110 100,128 Z">
                        <Path.RenderTransform><RotateTransform Angle="-62" CenterX="100" CenterY="128" /></Path.RenderTransform>
                    </Path>
                    <Path Fill="{ThemeResource PgLotusBrush}" Data="M100,128 C78,110 70,72 100,30 C130,72 122,110 100,128 Z">
                        <Path.RenderTransform><RotateTransform Angle="62" CenterX="100" CenterY="128" /></Path.RenderTransform>
                    </Path>
                    <Path Fill="{ThemeResource PgLotusBrush}" Stroke="{ThemeResource PgContentBackgroundBrush}" StrokeThickness="1.6"
                          Data="M100,128 C76,108 68,64 100,18 C132,64 124,108 100,128 Z">
                        <Path.RenderTransform><RotateTransform Angle="-31" CenterX="100" CenterY="128" /></Path.RenderTransform>
                    </Path>
                    <Path Fill="{ThemeResource PgLotusBrush}" Stroke="{ThemeResource PgContentBackgroundBrush}" StrokeThickness="1.6"
                          Data="M100,128 C76,108 68,64 100,18 C132,64 124,108 100,128 Z">
                        <Path.RenderTransform><RotateTransform Angle="31" CenterX="100" CenterY="128" /></Path.RenderTransform>
                    </Path>
                    <Path Fill="{ThemeResource PgLotusBrush}" Stroke="{ThemeResource PgContentBackgroundBrush}" StrokeThickness="1.6"
                          Data="M100,130 C72,108 66,58 100,6 C134,58 128,108 100,130 Z" />
                    <!-- Đài sen / mặt nước. -->
                    <Path Fill="{ThemeResource PgLotusBrush}" Stroke="{ThemeResource PgContentBackgroundBrush}" StrokeThickness="1.6"
                          Data="M38,132 C70,122 130,122 162,132 C130,146 70,146 38,132 Z" />
                </Canvas>
            </Viewbox>
        </Grid>

        <!-- Lớp nền thanh menu trái: sáng hơn 1 chút + hình tròn mờ ngẫu nhiên (seed cố định, ổn định giữa các lần mở). -->
        <Grid x:Name="PaneBackdrop" HorizontalAlignment="Left" Width="48" Background="{ThemeResource PgPaneBackgroundBrush}" IsHitTestVisible="False">
            <Canvas x:Name="PaneCircles" />
        </Grid>

        <NavigationView x:Name="Nav" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left" OpenPaneLength="240"
                        SelectionChanged="OnSelectionChanged">
            <NavigationView.Resources>
                <!-- Nền thật do 2 lớp backdrop phía sau vẽ. PaneDisplayMode=Left: pane luôn nằm cạnh nội dung
                     (thu gọn = dải 48px), không bao giờ chồng lên nội dung nên nền trong suốt an toàn. -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DashboardItem" Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AuditLogItem" Tag="AuditLog">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsItem" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Page>
