<Page
    x:Class="ParentalGuard.UI.Views.AuditLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ParentalGuard.UI.ViewModels"
    xmlns:local="using:ParentalGuard.UI.Views">

    <!-- Bố cục (bug real-hardware 2026-10-01): cột nội dung căn giữa, rộng tối đa 760, phần tử bên trong align trái. -->
    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20*" MaxWidth="760" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
    <Grid Grid.Column="1" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- FE-080/FE-081 (PWD-024): khung đăng nhập phụ huynh — chưa đăng nhập thì chưa tải lịch sử. -->
        <local:ParentLoginPanel Grid.Row="0" />

        <InfoBar Grid.Row="1" Severity="Error" IsClosable="False"
                 IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        <InfoBar Grid.Row="2" Severity="Success" IsClosable="False"
                 IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

        <ProgressRing Grid.Row="3" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- FE-040 — trạng thái rỗng tích cực. -->
        <TextBlock x:Name="EmptyText" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

        <!-- Mục 6.3 — mỗi dòng: thời gian, event_type dịch tiếng Việt; dòng ContentBlocked kèm process_name/risk_score (MISC-030a: không còn nút "Đánh dấu sai"). -->
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.ShowEntries, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:AuditLogRowViewData">
                    <StackPanel Orientation="Vertical" Spacing="4" Padding="0,8" BorderThickness="0,0,0,1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind TimestampText}" Opacity="0.7" />
                            <TextBlock Text="{x:Bind EventTypeText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind IsContentBlocked}">
                            <TextBlock Text="{x:Bind ProcessDisplayText}" />
                            <TextBlock Text="{x:Bind RiskScoreDisplayText}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button x:Name="LoadMoreButton" Grid.Row="4" Click="OnLoadMoreClick" HorizontalAlignment="Center"
                Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsNotLoadingMore, Mode=OneWay}" />
    </Grid>
    </Grid>
</Page>
