<Page
    x:Class="ParentalGuard.UI.Views.AuditLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ParentalGuard.UI.ViewModels">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar Grid.Row="0" Severity="Error" IsClosable="False"
                 IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        <InfoBar Grid.Row="1" Severity="Success" IsClosable="False"
                 IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

        <ProgressRing Grid.Row="2" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- FE-040 — trạng thái rỗng tích cực. -->
        <TextBlock x:Name="EmptyText" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

        <!-- Mục 6.3 — mỗi dòng: thời gian, event_type dịch tiếng Việt; dòng ContentBlocked kèm process_name/risk_score + "Đánh dấu sai". -->
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.ShowEntries, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:AuditLogRowViewData">
                    <StackPanel Orientation="Vertical" Spacing="4" Padding="0,8" BorderThickness="0,0,0,1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind TimestampText}" Opacity="0.7" />
                            <TextBlock Text="{x:Bind EventTypeText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind IsContentBlocked}">
                            <TextBlock Text="{x:Bind ProcessDisplayText}" />
                            <TextBlock Text="{x:Bind RiskScoreDisplayText}" />
                            <Button Tag="{x:Bind ProcessName}" Click="OnMarkFalsePositiveClick" Loaded="OnMarkFalsePositiveButtonLoaded" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button x:Name="LoadMoreButton" Grid.Row="3" Click="OnLoadMoreClick" HorizontalAlignment="Center"
                Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsNotLoadingMore, Mode=OneWay}" />
    </Grid>
</Page>
