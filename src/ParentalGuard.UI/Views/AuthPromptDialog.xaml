<ContentDialog
    x:Class="ParentalGuard.UI.Views.AuthPromptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="Xác nhận mật khẩu"
    PrimaryButtonText="Xác nhận"
    CloseButtonText="Huỷ"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel Spacing="12" MinWidth="320">
        <TextBlock Text="{x:Bind ViewModel.PurposeText}" TextWrapping="Wrap" />
        <PasswordBox x:Name="PasswordInput" PlaceholderText="Mật khẩu" IsEnabled="{x:Bind ViewModel.IsSubmitEnabled, Mode=OneWay}" />
        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
        <HyperlinkButton Content="Quên mật khẩu?" Click="OnForgotPasswordClick" />
    </StackPanel>
</ContentDialog>
