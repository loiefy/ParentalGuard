<Page
    x:Class="ParentalGuard.UI.Views.RecoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MinWidth="320" MaxWidth="480">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" />

            <!-- Mục 6.6 — form nhập, ẩn đi sau khi hiện Recovery Key mới (SUCCESS). -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsFormVisible, Mode=OneWay}">
                <TextBlock x:Name="RecoveryKeyLabel" />
                <TextBox x:Name="RecoveryKeyInput" PlaceholderText="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX" />
                <TextBlock x:Name="NewPasswordLabel" />
                <PasswordBox x:Name="NewPasswordInput" MaxLength="50" />
                <TextBlock x:Name="ConfirmNewPasswordLabel" />
                <PasswordBox x:Name="ConfirmNewPasswordInput" MaxLength="50" />

                <InfoBar Severity="Error" IsClosable="False"
                         IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              HorizontalAlignment="Center" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="SubmitButton" Click="OnSubmitClick"
                            IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}" />
                    <HyperlinkButton x:Name="CancelLink" Click="OnCancelClick"
                                     IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <!-- Mục 6.6 — hiện Recovery Key mới đúng 1 lần (PWD-032), cùng mẫu hình S1 bước 3/S4. -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasNewRecoveryKeyDisplay, Mode=OneWay}">
                <TextBlock x:Name="NewRecoveryKeyBody" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.NewRecoveryKeyDisplay, Mode=OneWay}"
                           FontFamily="Consolas" FontSize="18" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CopyButton" Click="OnCopyClick" />
                    <Button x:Name="AcknowledgeButton" Click="OnAcknowledgeClick" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
