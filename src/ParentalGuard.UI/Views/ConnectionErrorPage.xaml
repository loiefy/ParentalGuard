<Page
    x:Class="ParentalGuard.UI.Views.ConnectionErrorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="420">
            <FontIcon Glyph="&#xE783;" FontSize="48" HorizontalAlignment="Center" />
            <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            <Button x:Name="RetryButton" HorizontalAlignment="Center" Click="OnRetryClick" />
        </StackPanel>
    </Grid>
</Page>
