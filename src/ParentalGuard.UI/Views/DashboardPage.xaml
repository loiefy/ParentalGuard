<Page
    x:Class="ParentalGuard.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20" MaxWidth="720" HorizontalAlignment="Stretch"
                    Opacity="{x:Bind ViewModel.ContentOpacity, Mode=OneWay}">

            <InfoBar x:Name="ConnectionLostInfoBar" Severity="Error"
                     IsOpen="{x:Bind ViewModel.ConnectionLost, Mode=OneWay}" IsClosable="False" />

            <InfoBar x:Name="AnomalyInfoBar" Severity="Warning" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.ShowAnomalyBanner, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button x:Name="AnomalyAckButton" Command="{x:Bind ViewModel.AcknowledgeAnomalyCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar Severity="Informational" IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />

            <!-- 1. Thẻ trạng thái tổng quan (mục 6.2.1) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Ellipse Width="16" Height="16" Fill="#2E7D32" VerticalAlignment="Center"
                             Visibility="{x:Bind ViewModel.IsActiveState, Mode=OneWay}" />
                    <Ellipse Width="16" Height="16" Fill="#F9A825" VerticalAlignment="Center"
                             Visibility="{x:Bind ViewModel.IsPausedState, Mode=OneWay}" />
                    <Ellipse Width="16" Height="16" Fill="#C62828" VerticalAlignment="Center"
                             Visibility="{x:Bind ViewModel.IsErrorState, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusCardText, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 2. Nút Pause/Resume (mục 6.2.2) -->
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsNotPaused, Mode=OneWay}">
                <TextBlock x:Name="PauseDurationLabel" VerticalAlignment="Center" />
                <ComboBox x:Name="PauseDurationCombo"
                          ItemsSource="{x:Bind ViewModel.PauseDurationChoices}"
                          SelectedItem="{x:Bind ViewModel.SelectedPauseDurationChoice, Mode=TwoWay}"
                          DisplayMemberPath="Label" />
                <Button x:Name="PauseButton" Click="OnPauseClick" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
            </StackPanel>
            <Button x:Name="ResumeButton" Click="OnResumeClick"
                    Visibility="{x:Bind ViewModel.IsPaused, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />

            <!-- 4. Health check (mục 6.2.4, MISC-050/FE-041) -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="HealthTitleText" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.WatchdogStatusText, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.VisionStatusText, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.OverlayStatusText, Mode=OneWay}" />
                <InfoBar x:Name="DiskSpaceLowInfoBar" Severity="Warning" IsOpen="{x:Bind ViewModel.DiskSpaceLow, Mode=OneWay}" IsClosable="False" />
                <InfoBar x:Name="FallbackConfigInfoBar" Severity="Warning" IsOpen="{x:Bind ViewModel.UsingFallbackConfig, Mode=OneWay}" IsClosable="False" />
                <Expander x:Name="HealthDetailsExpander" IsExpanded="False" HorizontalContentAlignment="Stretch">
                    <TextBlock Text="{x:Bind ViewModel.VisionDiagnosticStateDetail, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" />
                </Expander>
            </StackPanel>

            <!-- 5. Biểu đồ (mục 6.2.5, FE-070-072) -->
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ChartTitleText" Grid.Column="0" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="Chart7Button" Click="OnChart7Click" />
                        <Button x:Name="Chart30Button" Click="OnChart30Click" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ChartEmptyText" Visibility="{x:Bind ViewModel.IsChartEmpty, Mode=OneWay}" />
                <Canvas x:Name="ChartCanvas" Height="160"
                        Visibility="{x:Bind ViewModel.HasChartData, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.ChartSummaryText, Mode=OneWay}"
                        SizeChanged="OnChartCanvasSizeChanged" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
