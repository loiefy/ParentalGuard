<Page
    x:Class="ParentalGuard.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <!-- Bố cục (bug real-hardware 2026-10-01): cột nội dung căn giữa cửa sổ, rộng tối đa 760, mọi phần tử
             bên trong align trái với nhau; 2 cột * hai bên hấp thụ phần dư khi kéo giãn cửa sổ. -->
        <Grid Padding="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20*" MaxWidth="760" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Spacing="20" HorizontalAlignment="Stretch"
                    Opacity="{x:Bind ViewModel.ContentOpacity, Mode=OneWay}">

            <InfoBar x:Name="ConnectionLostInfoBar" Severity="Error"
                     IsOpen="{x:Bind ViewModel.ConnectionLost, Mode=OneWay}" IsClosable="False" />

            <InfoBar x:Name="AnomalyInfoBar" Severity="Warning" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.ShowAnomalyBanner, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button x:Name="AnomalyAckButton" Command="{x:Bind ViewModel.AcknowledgeAnomalyCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar Severity="Informational" IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />

            <!-- 1. Thẻ trạng thái tổng quan (mục 6.2.1). FE-042: đang bảo vệ = dấu tích xanh lá + "Máy tính đang được bảo vệ";
                 tạm dừng/gián đoạn có biểu tượng + màu riêng (vàng/đỏ) đối lập rõ. -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Grid Width="40" Height="40" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsActiveState, Mode=OneWay}">
                        <Ellipse Fill="#2E7D32" />
                        <FontIcon Glyph="&#xE73E;" FontSize="20" Foreground="White" />
                    </Grid>
                    <Grid Width="40" Height="40" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsPausedState, Mode=OneWay}">
                        <Ellipse Fill="#F9A825" />
                        <FontIcon Glyph="&#xE769;" FontSize="18" Foreground="White" />
                    </Grid>
                    <Grid Width="40" Height="40" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsErrorState, Mode=OneWay}">
                        <Ellipse Fill="#C62828" />
                        <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="White" />
                    </Grid>
                    <ProgressRing Width="28" Height="28" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.IsCheckingState, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsCheckingState, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusCardText, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 2. Nút Pause/Resume (mục 6.2.2) -->
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsNotPaused, Mode=OneWay}">
                <TextBlock x:Name="PauseDurationLabel" VerticalAlignment="Center" />
                <ComboBox x:Name="PauseDurationCombo"
                          ItemsSource="{x:Bind ViewModel.PauseDurationChoices}"
                          SelectedItem="{x:Bind ViewModel.SelectedPauseDurationChoice, Mode=TwoWay}"
                          DisplayMemberPath="Label" />
                <Button x:Name="PauseButton" Click="OnPauseClick" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
            </StackPanel>
            <Button x:Name="ResumeButton" Click="OnResumeClick"
                    Visibility="{x:Bind ViewModel.IsPaused, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />

            <!-- 4. Health check (mục 6.2.4, MISC-050/FE-041) -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="HealthTitleText" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.WatchdogStatusText, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.VisionStatusText, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.OverlayStatusText, Mode=OneWay}" />
                <InfoBar x:Name="DiskSpaceLowInfoBar" Severity="Warning" IsOpen="{x:Bind ViewModel.DiskSpaceLow, Mode=OneWay}" IsClosable="False" />
                <InfoBar x:Name="FallbackConfigInfoBar" Severity="Warning" IsOpen="{x:Bind ViewModel.UsingFallbackConfig, Mode=OneWay}" IsClosable="False" />
            </StackPanel>

            <!-- 5. Biểu đồ (mục 6.2.5, FE-070-072) -->
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.ChartTitleText, Mode=OneWay}" Grid.Column="0" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <!-- FE-071a: chọn nhanh 1 tuần / 1 tháng / 3 tháng / 6 tháng (nút đang chọn tô màu nhấn). -->
                    <StackPanel x:Name="ChartRangeButtons" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="Chart7Button" Tag="7" Click="OnChartRangeClick" />
                        <Button x:Name="Chart30Button" Tag="30" Click="OnChartRangeClick" />
                        <Button x:Name="Chart90Button" Tag="90" Click="OnChartRangeClick" />
                        <Button x:Name="Chart180Button" Tag="180" Click="OnChartRangeClick" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ChartEmptyText" Visibility="{x:Bind ViewModel.IsChartEmpty, Mode=OneWay}" />
                <Canvas x:Name="ChartCanvas" Height="160"
                        Visibility="{x:Bind ViewModel.HasChartData, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.ChartSummaryText, Mode=OneWay}"
                        SizeChanged="OnChartCanvasSizeChanged" />
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
