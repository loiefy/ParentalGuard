<Project>

  <!-- Chuẩn chung cho mọi project trong src/ (DEV-020/022/023) — tránh lặp lại ở từng .csproj. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- DEV-023: warning-as-error riêng cho nhóm rule bảo mật (CA2xxx deserialization/injection, CA3xxx injection, CA5xxx crypto). -->
    <WarningsAsErrors>CA2100;CA2109;CA2119;CA2153;CA2300;CA2301;CA2302;CA2305;CA2310;CA2311;CA2312;CA2315;CA2321;CA2322;CA2326;CA2327;CA2328;CA2329;CA2330;CA2350;CA2351;CA2352;CA2353;CA2354;CA2355;CA2356;CA2361;CA2362;CA3001;CA3002;CA3003;CA3004;CA3005;CA3006;CA3007;CA3008;CA3009;CA3010;CA3011;CA3012;CA5350;CA5351;CA5358;CA5359;CA5360;CA5361;CA5362;CA5363;CA5364;CA5365;CA5366;CA5367;CA5368;CA5369;CA5370;CA5371;CA5372;CA5373;CA5374;CA5375;CA5376;CA5377;CA5378;CA5379;CA5380;CA5381;CA5382;CA5383;CA5384;CA5385;CA5386;CA5387;CA5388;CA5389;CA5390;CA5391;CA5392;CA5393;CA5394;CA5395;CA5396;CA5397;CA5398;CA5399;CA5400;CA5401;CA5402;CA5403</WarningsAsErrors>
  </PropertyGroup>

  <!-- FE-007 (2026-10-01): phiên bản phần mềm — 1 nguồn duy nhất cho cả 6 executable, hiện ở chân thanh menu và
       tab Giới thiệu của Dashboard. Đổi khi phát hành bằng cách sửa giá trị dưới đây, hoặc ghi đè lúc build:
       `dotnet publish ... -p:Version=1.2.3` (hoặc -p:VersionPrefix=1.2.3 -p:VersionSuffix=beta1). -->
  <PropertyGroup>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.9.0</VersionPrefix>
    <!-- Không gắn hash commit vào InformationalVersion (chỉ cần số phiên bản hiển thị cho người dùng). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Đợt 9 — cờ bật/tắt log chẩn đoán runtime (DebugLog trong Vision/Overlay/IpcChildClient, ghi
       C:\PGDebugLog\*.log): mặc định TẮT (không ảnh hưởng production, không có overhead — dùng
       [Conditional], lời gọi bị loại bỏ hoàn toàn khỏi binary khi cờ tắt, không chỉ no-op runtime).
       Bật khi cần điều tra sự cố thật trên máy: thêm -p:ParentalGuardDiagnosticLog=true vào lệnh
       `dotnet publish`/`dotnet build`. -->
  <PropertyGroup>
    <ParentalGuardDiagnosticLog Condition="'$(ParentalGuardDiagnosticLog)' == ''">false</ParentalGuardDiagnosticLog>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ParentalGuardDiagnosticLog)' == 'true'">
    <DefineConstants>$(DefineConstants);PARENTALGUARD_DIAGNOSTIC_LOG</DefineConstants>
  </PropertyGroup>

  <!-- DEV-050..052 (2026-10-06): chế độ developer — viền đỏ cam quanh cửa sổ đang theo dõi + ô tròn % rủi ro (Service
       gửi DebugWindowScore, Overlay vẽ). Chỉ bật/tắt ở đây hoặc lúc build, KHÔNG có tuỳ chọn runtime.
       Mặc định BẬT cho bản dev/thử nghiệm. Bản PRODUCTION phát hành cho người dùng BẮT BUỘC build với
       -p:ParentalGuardDeveloperMode=false (lời gọi/code vẽ bị loại khỏi binary qua #if). -->
  <PropertyGroup>
    <ParentalGuardDeveloperMode Condition="'$(ParentalGuardDeveloperMode)' == ''">true</ParentalGuardDeveloperMode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ParentalGuardDeveloperMode)' == 'true'">
    <DefineConstants>$(DefineConstants);PARENTALGUARD_DEVELOPER_MODE</DefineConstants>
  </PropertyGroup>

  <!-- DEV-050 (debug, 2026-10-06): bản DEBUG quay màn hình — giữ nguyên nhận diện + khung developer, nhưng Service KHÔNG
       dựng overlay khi phát hiện vi phạm (và không ghi ContentBlocked). Mặc định TẮT; chỉ bật khi build bản debug:
       -p:ParentalGuardSuppressOverlay=true. Tuyệt đối không dùng cho bản phát hành. -->
  <PropertyGroup>
    <ParentalGuardSuppressOverlay Condition="'$(ParentalGuardSuppressOverlay)' == ''">false</ParentalGuardSuppressOverlay>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ParentalGuardSuppressOverlay)' == 'true'">
    <DefineConstants>$(DefineConstants);PARENTALGUARD_SUPPRESS_OVERLAY</DefineConstants>
  </PropertyGroup>
  <!-- DEV-050 (debug, 2026-10-06): bản DEBUG quét nhanh — mỗi cửa sổ đang hiển thị được phân loại 2 lần/giây (chu kỳ cố
       định 500ms tính cả thời gian xử lý, mọi cửa sổ trong 1 chu kỳ, chờ khung hình tối đa 50ms) để khung developer cập
       nhật liên tục. Tốn CPU hơn nhiều — mặc định TẮT; chỉ bật khi build bản debug: -p:ParentalGuardFastDetection=true. -->
  <PropertyGroup>
    <ParentalGuardFastDetection Condition="'$(ParentalGuardFastDetection)' == ''">false</ParentalGuardFastDetection>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ParentalGuardFastDetection)' == 'true'">
    <DefineConstants>$(DefineConstants);PARENTALGUARD_FAST_DETECTION</DefineConstants>
  </PropertyGroup>
  <!-- 2026-10-06 (thử nghiệm theo yêu cầu chủ dự án): chọn mô hình AI nhận diện cho Vision — GantMan (mặc định, 5 lớp,
       224×224), Marqo (Marqo/nsfw-image-detection-384, Apache-2.0, ViT-tiny 384×384) hoặc Falconsai
       (Falconsai/nsfw_image_detection, Apache-2.0, ViT-base 224×224). File .onnx tương ứng phải có trong thư mục models/
       của bản cài (tools/export_nsfw_models.py tạo 2 file mới). Ví dụ: -p:ParentalGuardModel=Marqo -->
  <PropertyGroup>
    <ParentalGuardModel Condition="'$(ParentalGuardModel)' == ''">GantMan</ParentalGuardModel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ParentalGuardModel)' == 'Marqo'">
    <DefineConstants>$(DefineConstants);PARENTALGUARD_MODEL_MARQO</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ParentalGuardModel)' == 'Falconsai'">
    <DefineConstants>$(DefineConstants);PARENTALGUARD_MODEL_FALCONSAI</DefineConstants>
  </PropertyGroup>

</Project>
