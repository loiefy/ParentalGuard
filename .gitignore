# .NET / WinUI 3 (DEV-003)
bin/
obj/
.vs/
*.user
*.suo
publish/
AppPackages/
BundleArtifacts/

# Secret file patterns (DEV-011) — never commit these
*.pfx
*.p12
*.snk
*.cer
.env
appsettings.*.local.json
secrets.json
*secret*
*credential*
*key*.json

# The 3 wildcard patterns above are name-substring matches, not extension
# matches — they can accidentally swallow legitimate source files whose
# class/file name merely contains "secret"/"credential"/"key" (e.g.
# src/ParentalGuard.Ipc/Security/CredentialBytes.cs, silently untracked
# since Đợt 3 until caught by security-privacy-auditor 2026-09-25). Source
# code must never be excluded by these patterns — only real secret payloads
# (.pfx/.p12/.snk/.cer/.env/secrets.json/etc. above) are.
!*.cs
!*.xaml
!*.csproj
!*.sln
!*.proto

# OS / editor noise
.DS_Store
Thumbs.db
